# Day 14 starter hiện tại có thể chạy mà không cần API key thật.
# Khi nhóm chuyển sang bản dùng model/judge ngoài, hãy copy file này thành `.env`
# rồi điền giá trị tương ứng.

OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

PROVIDER=openai
JUDGE_PROVIDER=openai

OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
VOYAGE_EMBED_MODEL=voyage-3-large
